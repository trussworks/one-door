{
  "name": "one-door",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup:env": "node --experimental-strip-types scripts/setup-env.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/db-seed.ts",
    "db:reset-fixtures": "node --env-file-if-exists=.env --experimental-strip-types scripts/db-reset-fixtures.ts",
    "db:import-fixture": "node --env-file-if-exists=.env --experimental-strip-types scripts/db-import-fixture.ts",
    "db:upgrade-fixtures": "node --env-file-if-exists=.env --experimental-strip-types scripts/db-upgrade-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "seed:check": "node --experimental-strip-types src/seed/check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run seed:check && vitest run",
    "test:db": "node --env-file-if-exists=.env --experimental-strip-types test/database.integration.ts",
    "test:fixtures": "node --env-file-if-exists=.env --experimental-strip-types test/fixture-operations.integration.ts",
    "test:fixture-upgrade": "node --env-file-if-exists=.env --experimental-strip-types test/fixture-upgrade.integration.ts",
    "test:workflow": "node --env-file-if-exists=.env --experimental-strip-types test/workflow.integration.ts && node --env-file-if-exists=.env --experimental-strip-types test/workflow-safety.integration.ts",
    "test:api": "node --env-file-if-exists=.env --experimental-strip-types test/api.integration.ts",
    "test:review": "node --env-file-if-exists=.env --experimental-strip-types test/review.integration.ts",
    "test:intake": "node --env-file-if-exists=.env --experimental-strip-types test/intake.integration.ts",
    "test:model": "node --env-file-if-exists=.env --experimental-strip-types test/model.integration.ts",
    "test:catalog": "node --env-file-if-exists=.env --experimental-strip-types test/catalog.integration.ts",
    "test:reset": "node --env-file-if-exists=.env --experimental-strip-types test/reset-interactions.integration.ts",
    "test:browser": "playwright test",
    "test:a11y": "playwright test test/accessibility.acceptance.ts",
    "test:container": "node --experimental-strip-types test/container.integration.ts",
    "test:read-model": "node --env-file-if-exists=.env --experimental-strip-types test/read-model.integration.ts",
    "test:admin-notes": "node --env-file-if-exists=.env --experimental-strip-types test/admin-notes.integration.ts",
    "test:lifecycle-fixtures": "node --env-file-if-exists=.env --experimental-strip-types test/lifecycle-fixtures.integration.ts",
    "test:upgrade-lifecycle": "node --env-file-if-exists=.env --experimental-strip-types test/upgrade-lifecycle.integration.ts",
    "test:review-corrections": "node --env-file-if-exists=.env --experimental-strip-types test/review-corrections.integration.ts",
    "test:delivery-lineage": "node --env-file-if-exists=.env --experimental-strip-types test/delivery-lineage.integration.ts",
    "test:cache-currency": "node --env-file-if-exists=.env --experimental-strip-types test/cache-currency.integration.ts",
    "test:requester-fit": "node --env-file-if-exists=.env --experimental-strip-types test/requester-fit.integration.ts",
    "test:intake-workspace": "node --env-file-if-exists=.env --experimental-strip-types test/intake-workspace.integration.ts",
    "test:bootstrap": "node --env-file-if-exists=.env --experimental-strip-types test/db-bootstrap.integration.ts",
    "test:inspect": "node --experimental-strip-types test/deployment/db-inspect.integration.ts",
    "test:worker-shutdown": "node --experimental-strip-types test/worker-shutdown.integration.ts",
    "worker": "node --env-file-if-exists=.env --experimental-strip-types scripts/model-worker.ts",
    "security": "node --experimental-strip-types scripts/scan-secrets.ts --worktree",
    "audit": "npm audit --audit-level=high",
    "security:history": "node --experimental-strip-types scripts/scan-secrets.ts --history",
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) require('node:child_process').execFileSync('git', ['config', 'core.hooksPath', '.githooks']);\"",
    "checkpoints:publish": "node --experimental-strip-types scripts/publish-checkpoints.ts",
    "test:priority": "npm run db:migrate && npm run db:seed && node --env-file-if-exists=.env --experimental-strip-types test/priority.integration.ts",
    "test:review-inputs": "npm run db:migrate && npm run db:seed && node --env-file-if-exists=.env --experimental-strip-types test/review-inputs.integration.ts",
    "test:review-submission": "npm run db:migrate && npm run db:seed && node --env-file-if-exists=.env --experimental-strip-types test/review-submission.integration.ts",
    "test:review-input-queue": "npm run db:migrate && npm run db:seed && node --env-file-if-exists=.env --experimental-strip-types test/review-input-queue.integration.ts",
    "test:requester-priority": "npm run db:migrate && npm run db:seed && node --env-file-if-exists=.env --experimental-strip-types test/requester-priority.integration.ts"
  },
  "dependencies": {
    "@trussworks/react-uswds": "12.0.0",
    "@uswds/uswds": "3.13.0",
    "drizzle-orm": "0.45.2",
    "focus-trap-react": "11.0.6",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.3.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "4.9.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "secretlint": "^9.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
