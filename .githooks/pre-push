#!/bin/sh
is_deleted_ref() {
  case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac
}
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  is_deleted_ref "$local_sha" && continue
  case "$remote_sha" in
    *[!0]*)
      node --experimental-strip-types scripts/scan-secrets.ts --range "$remote_sha..$local_sha" || status=1
      ;;
    *)
      node --experimental-strip-types scripts/scan-secrets.ts --range "$local_sha" || status=1
      ;;
  esac
done
exit $status
