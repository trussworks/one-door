# For normal local setup, run npm run setup:env. Keep an existing .env or
# .env.local; the generator refuses to replace either configuration.
# This file is the manual reference: fill the blank values in a private .env
# beside package.json, never under src/ or in a tracked file.

# compose.yaml reads these values from .env. Use the same user and password
# in DATABASE_URL; changing this file does not rotate an existing database.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Read only on the server. The name carries no NEXT_PUBLIC_ prefix, so Next.js
# never inlines it into the browser bundle.
DATABASE_URL=

# Set a private demo access code (at least 12 characters) and a separate,
# randomly generated signing secret (at least 32 characters).
DEMO_ACCESS_CODE=
SESSION_SECRET=
# Pin the public origin when deploying behind a proxy, for example https://demo.example.org.
APP_ORIGIN=

# Runtime model access is separate from the coding-agent account.
# On macOS, leaving this unset uses the Keychain service anthropic-api.
ANTHROPIC_API_KEY=
